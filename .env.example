# 服务对外端口（仅 Docker Compose 部署生效；裸机部署用 uvicorn --port 指定）
APP_PORT=8000

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=driveintent
DB_NAME=driveintent
# 连接池：pool_size + max_overflow 为并发连接上限，需覆盖
# WORKER_CONCURRENCY + API_WORKER_CONCURRENCY + Web 请求并发峰值
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
# Web 同步端点的并发上限（anyio 线程池槽位）。FastAPI 的 def 端点每个在途请求
# 独占一条 DB 连接直到请求结束，anyio 默认 40 槽会超出连接池容量并触发
# QueuePool timeout，故显式收敛。必须 ≤ DB_POOL_SIZE + DB_MAX_OVERFLOW，
# 且留出余量给两个 worker；超出时启动会自动下调并告警。
WEB_THREADPOOL_SLOTS=20

# LLM（OpenAI 兼容）
# 真实模型联调请设为 openai_compat，BASE_URL 需含 /v1 前缀（如 https://api.example.com/v1）
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
# 文本模型：工作流中不使用多模态能力的节点（视频语境/评论初筛/用户分析）默认使用
LLM_MODEL=mock-model
# 多模态模型：需多模态能力的节点（主页截图识别等）默认使用；留空则回退到 LLM_MODEL。
# 文本/多模态模型共用上面的 BASE_URL 与 API_KEY，仅模型名不同。
LLM_MULTIMODAL_MODEL=
# 深度思考开关（全局）：true 时对 openai_compat 请求注入 enable_thinking=true。
# 注意：enable_thinking 是 Qwen/DashScope 等端点的扩展字段，部分严格校验未知
# 参数的端点可能拒绝；默认 false（不思考）为安全路径。
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# V1 API
API_KEYS=change-me-key1,change-me-key2
API_WORKER_ENABLED=true
API_WORKER_CONCURRENCY=3

# Worker
WORKER_ENABLED=true
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL=1.0
COMMENT_BATCH_SIZE=30

# V1.1 我方车型匹配与意向降级
OUR_MODELS_CONFIG_PATH=config/our_models.json
INTENT_DOWNGRADE_ENABLED=true
